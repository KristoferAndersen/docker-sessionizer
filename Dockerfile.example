# Example: consuming repo Dockerfile
# Build the base image locally first:
#   docker build -t dev-base /path/to/docker-sessionizer
#
# Run available install scripts from /usr/local/lib/dev-scripts/. Each installs
# to a fixed location; put those on PATH yourself with ENV (scripts don't):
#   install-go.sh     - Go        -> /usr/local/go/bin (env: GO_VERSION)
#   install-neovim.sh - Neovim    -> /usr/local/nvim/bin (env: NVIM_VERSION)
#   install-claude.sh - Claude    -> ~/.local/bin

FROM dev-base:latest

# Install only what this repo needs
RUN GO_VERSION=1.23.5 /usr/local/lib/dev-scripts/install-go.sh
RUN /usr/local/lib/dev-scripts/install-claude.sh

# Put the installed tools on PATH
ENV GOPATH="/home/dev/go"
ENV PATH="/home/dev/.local/bin:/usr/local/go/bin:/home/dev/go/bin:${PATH}"
